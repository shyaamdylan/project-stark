# Copy this file to `.env` and fill in your keys.
#   cp .env.example .env
#
# When running the packaged app, put the .env file here instead:
#   ~/Library/Application Support/Project Alpha/.env
#
# Never commit your real .env (it's already in .gitignore).

# --- ElevenLabs (the buddy's voice) -----------------------------------------
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice ID from https://elevenlabs.io/app/voice-library (the default is "Jessica", warm and bright)
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
# Expressive real-time model (~100 ms to first audio). eleven_flash_v2_5 is plainer but just as quick.
ELEVENLABS_MODEL_ID=eleven_v4_turbo

# --- Claude (step-by-step walkthroughs) --------------------------------------
# Lets you ask "how do I…?" and get walked through it. Without it, the buddy
# only finds buttons by name. Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --- Reserved for future features (not used yet) ----------------------------
# Any other provider you want to plug in later.
OPENAI_API_KEY=

# --- Behaviour ---------------------------------------------------------------
# Say "Hey Alpha" to wake the buddy (or "Hey Alpha, how do I…" in one go).
# The mic listens in the background and sends speech to ElevenLabs to check for it.
# Set WAKE_WORD_ENABLED=0 to turn it off; you can also toggle it from the 👀 menu.
WAKE_WORD=alpha
WAKE_WORD_ENABLED=1
# Set to 0 to mute the buddy entirely.
VOICE_ENABLED=1
