# Copy this file to `.env` and fill in your keys.
#   cp .env.example .env
#
# When running the packaged app, put the .env file here instead:
#   ~/Library/Application Support/Project Alpha/.env
#
# Never commit your real .env (it's already in .gitignore).

# --- ElevenLabs (the buddy's voice) -----------------------------------------
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice ID from https://elevenlabs.io/app/voice-library (the default is "Rachel")
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8EgDs7
# Fast, low-latency model. Swap for eleven_multilingual_v2 for higher quality.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Reserved for future features (not used yet) ----------------------------
# Smarter "what did you mean?" matching / natural-language requests.
ANTHROPIC_API_KEY=
# Any other provider you want to plug in later.
OPENAI_API_KEY=

# --- Behaviour ---------------------------------------------------------------
# Set to 0 to mute the buddy entirely.
VOICE_ENABLED=1

# --- Jarvis: workspace + launcher (all optional) ------------------------------
# Only windows of these apps can be closed by "clean up my workspace", and only
# after one grouped question. Default: Finder, browsers, Preview, System Settings…
# JARVIS_CLOSABLE_APPS=Finder, Safari, Google Chrome, Arc
# Your own focus profiles: "organise for research" keeps exactly these apps.
# JARVIS_WORKSPACE_RESEARCH=Safari, Notes, Preview
# JARVIS_WORKSPACE_CODING=Cursor, Ghostty, Google Chrome
# Extra folders to look for projects in (comma separated). ~/Developer, ~/Projects,
# ~/Code, ~/src, ~/repos and ~/Documents/GitHub are always searched.
# JARVIS_PROJECT_DIRS=~/work, ~/clients
# Editor for "open project X". Default: first of Cursor, VS Code, Zed, Sublime, Nova, Xcode.
# JARVIS_EDITOR=Visual Studio Code
